<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Source for the "Voice Control On" shortcut installed by `hands-free init`.
  Managed by chezmoi - edit here, then run `chezmoi apply`.

  macOS only lets Apple-signed code flip Voice Control, so `hands-free` drives
  it through Shortcuts.app. `hands-free init` signs this file with
  `shortcuts sign` and opens it for the one-click Add Shortcut confirmation.

  The "turn on" case carries NO parameters. That is not an oversight: the
  Shortcuts editor omits `state` entirely for on, and writes `state: 0` for off
  (see voice-control-off.shortcut.plist). Supplying the `state`/`operation`
  values from the intent definition instead makes the action fail at run time
  with "An unknown error occurred", so keep this as the editor emits it.
-->
<plist version="1.0">
<dict>
	<key>WFWorkflowActions</key>
	<array>
		<dict>
			<key>WFWorkflowActionIdentifier</key>
			<string>com.apple.UniversalAccess.UASettingsShortcuts.UAToggleVoiceControlIntent</string>
			<key>WFWorkflowActionParameters</key>
			<dict/>
		</dict>
	</array>
	<key>WFWorkflowClientVersion</key>
	<string>2038.0.4</string>
	<key>WFWorkflowMinimumClientVersion</key>
	<integer>900</integer>
	<key>WFWorkflowMinimumClientVersionString</key>
	<string>900</string>
	<key>WFWorkflowIcon</key>
	<dict>
		<key>WFWorkflowIconGlyphNumber</key>
		<integer>59511</integer>
		<key>WFWorkflowIconStartColor</key>
		<integer>4282601983</integer>
	</dict>
	<key>WFWorkflowImportQuestions</key>
	<array/>
	<key>WFWorkflowInputContentItemClasses</key>
	<array/>
	<key>WFWorkflowTypes</key>
	<array/>
</dict>
</plist>
