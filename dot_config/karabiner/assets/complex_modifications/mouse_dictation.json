{
  "title": "Mouse dictation controls",
  "rules": [
    {
      "description": "Mouse 3 → Superwhisper start/stop",
      "manipulators": [
        {
          "type": "basic",
          "from": { 
            "pointing_button": "button3",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [{
            "key_code": "space",
            "modifiers": ["option"]
          }]
        }
      ]
    }
  ]
}